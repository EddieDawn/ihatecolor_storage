---
import { Image } from "astro:assets";

import { getPhotoPageHref } from "../../lib/content/photo-pagination";
import type { Photo } from "../../lib/content/photos";

interface Props {
  photos: Photo[];
  currentPage: number;
  totalPages: number;
  totalItems: number;
}

const { photos, currentPage, totalPages, totalItems } = Astro.props;

const photoMeta = (photo: Photo) =>
  [photo.location, photo.shotAt?.slice(0, 4)].filter(Boolean).join(" · ");

const documentTitle =
  currentPage === 1
    ? "Journal — FIELD"
    : `Journal — Page ${currentPage} — FIELD`;
const previousPageHref =
  currentPage > 1 ? getPhotoPageHref(currentPage - 1) : undefined;
const nextPageHref =
  currentPage < totalPages ? getPhotoPageHref(currentPage + 1) : undefined;
const paginationHref = (page: number) =>
  `${getPhotoPageHref(page)}#journal-title`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="도시와 사람 사이의 순간을 기록한 사진 저널입니다."
    />
    <title>{documentTitle}</title>
    {previousPageHref && <link rel="prev" href={previousPageHref} />}
    {nextPageHref && <link rel="next" href={nextPageHref} />}
  </head>
  <body>
    <a class="skip-link" href="#journal-grid">작품 목록으로 건너뛰기</a>

    <header class="site-header">
      <nav class="header-side" aria-label="주요 메뉴">
        <a aria-current="page" href="/photos/">Journal</a>
        <button type="button" data-coming-soon="Photographer">
          Photographer
        </button>
        <button type="button" data-coming-soon="Contact">Contact</button>
      </nav>

      <button
        class="wordmark"
        type="button"
        data-coming-soon="랜딩 페이지"
        aria-label="FIELD 홈"
      >
        FIELD
      </button>

      <div class="header-side header-side--right">
        <span>Seoul, KR</span>
        <a href="#journal-grid">Index</a>
        <button type="button" data-coming-soon="Instagram">Instagram</button>
      </div>
    </header>

    <main>
      <section class="intro" aria-labelledby="page-title">
        <p class="eyebrow">Selected journal · 2024—2026</p>
        <h1 id="page-title">Ordinary scenes,<br />held a little longer.</h1>
        <p class="intro-note">
          도시의 표면과 그 안을 지나는 사람들.<br />
          이름 없이 흘러가는 순간을 기록합니다.
        </p>
      </section>

      <section class="journal" aria-labelledby="journal-title">
        <div class="journal-toolbar">
          <h2 id="journal-title" tabindex="-1">Journal</h2>
          <p class="journal-page">
            Page {String(currentPage).padStart(2, "0")}
          </p>
          <p class="journal-count">
            {String(totalItems).padStart(2, "0")} stories
          </p>
        </div>

        {
          photos.length > 0 ? (
            <div class="journal-grid" id="journal-grid">
              {photos.map((photo, index) => {
                const meta = photoMeta(photo);

                return (
                  <article class="journal-card">
                    <div class="image-frame">
                      <Image
                        class="card-image"
                        src={photo.image}
                        alt={photo.altText}
                        widths={[420, 640, 840]}
                        sizes="(min-width: 1100px) 29vw, (min-width: 761px) 30vw, 100vw"
                        loading={index < 3 ? "eager" : "lazy"}
                      />
                    </div>
                    <div class="card-meta">
                      <h3>{photo.title}</h3>
                      <p>{meta || "—"}</p>
                    </div>
                  </article>
                );
              })}
            </div>
          ) : (
            <p class="empty-state" id="journal-grid">
              공개된 사진이 아직 없습니다.
            </p>
          )
        }

        {
          totalPages > 1 && (
            <nav class="pagination" aria-label="사진 목록 페이지">
              <div class="pagination-edge pagination-edge--previous">
                {currentPage > 1 && (
                  <a href={paginationHref(currentPage - 1)} rel="prev">
                    Previous
                  </a>
                )}
              </div>

              <ol>
                {Array.from(
                  { length: totalPages },
                  (_, index) => index + 1,
                ).map((page) => (
                  <li>
                    {page === currentPage ? (
                      <span aria-current="page">{page}</span>
                    ) : (
                      <a href={paginationHref(page)}>{page}</a>
                    )}
                  </li>
                ))}
              </ol>

              <div class="pagination-edge pagination-edge--next">
                {currentPage < totalPages && (
                  <a href={paginationHref(currentPage + 1)} rel="next">
                    Next
                  </a>
                )}
              </div>
            </nav>
          )
        }
      </section>
    </main>

    <footer id="contact">
      <a href="mailto:hello@example.com">hello@example.com</a>
      <p>Available for editorial assignments</p>
      <p>© FIELD, 2026</p>
    </footer>

    <dialog class="coming-soon-dialog" aria-labelledby="coming-soon-title">
      <div class="coming-soon-content">
        <p class="coming-soon-label">Coming soon</p>
        <h2 id="coming-soon-title">구현 예정</h2>
        <p class="coming-soon-message"></p>
        <button class="coming-soon-close" type="button">Close</button>
      </div>
    </dialog>

    <script>
      const comingSoonDialog = document.querySelector<HTMLDialogElement>(
        ".coming-soon-dialog",
      );
      const comingSoonMessage = comingSoonDialog?.querySelector<HTMLElement>(
        ".coming-soon-message",
      );
      const comingSoonClose =
        comingSoonDialog?.querySelector<HTMLButtonElement>(
          ".coming-soon-close",
        );

      document
        .querySelectorAll<HTMLElement>("[data-coming-soon]")
        .forEach((trigger) => {
          trigger.addEventListener("click", () => {
            if (!comingSoonDialog || !comingSoonMessage) return;

            const feature = trigger.dataset.comingSoon ?? "해당 기능";
            comingSoonMessage.textContent = `${feature} 기능은 현재 준비 중입니다.`;
            comingSoonDialog.showModal();
          });
        });

      comingSoonClose?.addEventListener("click", () =>
        comingSoonDialog?.close(),
      );
      comingSoonDialog?.addEventListener("click", (event) => {
        if (event.target === comingSoonDialog) comingSoonDialog.close();
      });

      if (window.location.hash === "#journal-title") {
        const journalTitle =
          document.querySelector<HTMLElement>("#journal-title");

        requestAnimationFrame(() => {
          journalTitle?.scrollIntoView({ block: "start" });
          journalTitle?.focus({ preventScroll: true });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #11110f;
    --paper: #f4f3ef;
    --line: rgba(17, 17, 15, 0.22);
    --muted: #72716c;
    --side: clamp(32px, 6.25vw, 100px);
    --font-sans:
      "Helvetica Neue", Helvetica, Arial, "Pretendard", "Apple SD Gothic Neo",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    color: var(--ink);
    background: var(--paper);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
  }

  body:has(.coming-soon-dialog[open]) {
    overflow: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    color: inherit;
    font: inherit;
  }

  img {
    display: block;
    max-width: 100%;
  }

  :focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 4px;
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    top: 12px;
    left: 12px;
    padding: 10px 14px;
    background: var(--ink);
    color: var(--paper);
    transform: translateY(-150%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 132px;
    padding: 0 var(--side);
    letter-spacing: 0.08em;
  }

  .header-side {
    display: flex;
    align-items: center;
    gap: clamp(22px, 3.1vw, 52px);
    font-size: 10px;
    text-transform: uppercase;
  }

  .header-side--right {
    justify-content: flex-end;
  }

  .header-side span {
    color: var(--muted);
  }

  .header-side a,
  .header-side button,
  footer a,
  .pagination a {
    position: relative;
  }

  .header-side a::after,
  .header-side button::after,
  footer a::after,
  .pagination a::after {
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 260ms ease;
  }

  .header-side a:hover::after,
  .header-side a:focus-visible::after,
  .header-side button:hover::after,
  .header-side button:focus-visible::after,
  footer a:hover::after,
  footer a:focus-visible::after,
  .pagination a:hover::after,
  .pagination a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header-side button {
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }

  .wordmark {
    padding: 8px 14px;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: 27px;
    font-weight: 500;
    letter-spacing: 0.22em;
    line-height: 1;
  }

  .intro {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    align-items: end;
    min-height: 440px;
    padding: 90px var(--side) 108px;
    border-bottom: 1px solid var(--line);
  }

  .eyebrow,
  .journal-count,
  .journal-page {
    margin: 0;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .intro h1 {
    max-width: 740px;
    margin: 0;
    font-size: clamp(48px, 5.35vw, 86px);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .intro-note {
    justify-self: end;
    margin: 0;
    color: #45443f;
    font-size: 11px;
    line-height: 1.8;
  }

  .journal {
    padding: 0 var(--side) 160px;
  }

  .journal-toolbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 112px;
  }

  .journal-toolbar h2 {
    justify-self: start;
    margin: 0;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .journal-page {
    justify-self: center;
  }

  .journal-count {
    justify-self: end;
  }

  .journal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(18px, 1.9vw, 30px);
    row-gap: 74px;
  }

  .journal-card {
    min-width: 0;
  }

  .image-frame {
    display: block;
    width: 100%;
    overflow: hidden;
    background: #deddd8;
    aspect-ratio: 3 / 4;
  }

  .image-frame .card-image {
    width: 100%;
    height: 100%;
    filter: grayscale(1);
    object-fit: cover;
    object-position: center;
    transform: scale(1.001);
    transition:
      filter 380ms ease,
      transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 12px;
    padding-top: 15px;
    border-top: 1px solid var(--ink);
  }

  .card-meta h3,
  .card-meta p {
    margin: 0;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.075em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .card-meta h3 {
    max-width: 62%;
  }

  .card-meta p {
    color: var(--muted);
    text-align: right;
  }

  .empty-state {
    min-height: 360px;
    margin: 0;
    padding-top: 42px;
    border-top: 1px solid var(--ink);
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-top: 80px;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pagination ol {
    display: flex;
    gap: 50px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pagination li span {
    padding-bottom: 4px;
    border-bottom: 2px solid var(--ink);
  }

  .pagination-edge--next {
    justify-self: end;
  }

  footer {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: end;
    min-height: 260px;
    padding: 90px var(--side) 46px;
    background: var(--ink);
    color: var(--paper);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  footer p {
    margin: 0;
  }

  footer p:nth-child(2) {
    text-align: center;
  }

  footer p:last-child {
    text-align: right;
  }

  .coming-soon-dialog {
    width: min(460px, calc(100vw - 36px));
    padding: 0;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }

  .coming-soon-dialog::backdrop {
    background: rgba(17, 17, 15, 0.55);
  }

  .coming-soon-content {
    padding: 42px;
  }

  .coming-soon-label,
  .coming-soon-message {
    margin: 0;
  }

  .coming-soon-label {
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .coming-soon-content h2 {
    margin: 18px 0 14px;
    font-size: 34px;
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .coming-soon-message {
    color: var(--muted);
    font-size: 11px;
  }

  .coming-soon-close {
    margin-top: 42px;
    padding: 8px 0;
    border: 0;
    border-bottom: 1px solid var(--ink);
    background: transparent;
    cursor: pointer;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (hover: hover) and (pointer: fine) {
    .journal-card:hover .card-image {
      filter: grayscale(0);
      transform: scale(1.025);
    }
  }

  @media (max-width: 760px) {
    :root {
      --side: 18px;
    }

    .site-header {
      grid-template-columns: 1fr auto;
      height: 70px;
      border-bottom: 1px solid var(--line);
    }

    .header-side {
      display: none;
    }

    .wordmark {
      grid-column: 1;
      justify-self: start;
      padding: 8px 0;
      font-size: 21px;
    }

    .intro {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      min-height: 465px;
      padding-top: 82px;
      padding-bottom: 34px;
    }

    .intro h1 {
      order: 2;
      margin-top: 20px;
      font-size: clamp(43px, 13.2vw, 58px);
    }

    .intro-note {
      order: 3;
      justify-self: auto;
      margin-top: 50px;
      font-size: 10px;
    }

    .journal {
      padding-bottom: 92px;
    }

    .journal-toolbar {
      height: 86px;
    }

    .journal-grid {
      grid-template-columns: 1fr;
      row-gap: 52px;
    }

    .image-frame .card-image {
      filter: none;
      transform: none;
    }

    .pagination {
      grid-template-columns: 1fr auto 1fr;
      margin-top: 64px;
    }

    .pagination ol {
      gap: 22px;
    }

    footer {
      display: flex;
      min-height: 320px;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      gap: 15px;
      padding-top: 80px;
      padding-bottom: 28px;
    }

    footer p:nth-child(2),
    footer p:last-child {
      text-align: left;
    }

    footer p:last-child {
      margin-top: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
