---
import { Image } from "astro:assets";

import { getPhotoPageHref } from "../../lib/content/photo-pagination";
import type { Photo } from "../../lib/content/photos";

interface Props {
  photos: Photo[];
  currentPage: number;
  totalPages: number;
  totalItems: number;
}

const { photos, currentPage, totalPages, totalItems } = Astro.props;

const photoMeta = (photo: Photo) =>
  [photo.location, photo.shotAt?.slice(0, 4)].filter(Boolean).join(" · ");

const documentTitle =
  currentPage === 1
    ? "Journal — Justyes"
    : `Journal — Page ${currentPage} — Justyes`;
const previousPageHref =
  currentPage > 1 ? getPhotoPageHref(currentPage - 1) : undefined;
const nextPageHref =
  currentPage < totalPages ? getPhotoPageHref(currentPage + 1) : undefined;
const paginationHref = (page: number) => getPhotoPageHref(page);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="도시와 사람 사이의 순간을 기록한 사진 저널입니다."
    />
    <title>{documentTitle}</title>
    {previousPageHref && <link rel="prev" href={previousPageHref} />}
    {nextPageHref && <link rel="next" href={nextPageHref} />}
  </head>
  <body>
    <header class="site-header">
      <div class="header-side">
        <button type="button" data-coming-soon="Contact">Contact</button>
      </div>

      <a class="wordmark" href="/" aria-label="Justyes 홈"> Justyes </a>

      <div class="header-side header-side--right">
        <a
          href="https://www.instagram.com/justyesgallery?igsi=MWJqaXJ5MWVqa2QyZg=="
          >Instagram</a
        >
      </div>
    </header>

    <main>
      <section class="journal" aria-labelledby="journal-title">
        <div class="journal-toolbar">
          <h1 id="journal-title">Journal</h1>
          <p class="journal-page">
            Page {String(currentPage).padStart(2, "0")}
          </p>
          <p class="journal-count">
            {String(totalItems).padStart(2, "0")} stories
          </p>
        </div>

        {
          photos.length > 0 ? (
            <div class="journal-grid">
              {photos.map((photo, index) => {
                const meta = photoMeta(photo);

                return (
                  <article class="journal-card">
                    <a
                      class="journal-card-link"
                      href={`/photos/${photo.slug}/`}
                    >
                      <div class="image-frame">
                        <Image
                          class="card-image"
                          src={photo.image.url}
                          width={photo.image.width}
                          height={photo.image.height}
                          alt={photo.altText}
                          widths={[420, 640, 840]}
                          sizes="(min-width: 1100px) 29vw, (min-width: 761px) 30vw, 100vw"
                          loading={index < 3 ? "eager" : "lazy"}
                        />
                      </div>
                      <div class="card-meta">
                        <h3>{photo.title}</h3>
                        <p>{meta || "—"}</p>
                      </div>
                    </a>
                  </article>
                );
              })}
            </div>
          ) : (
            <p class="empty-state">공개된 사진이 아직 없습니다.</p>
          )
        }

        {
          totalPages > 1 && (
            <nav class="pagination" aria-label="사진 목록 페이지">
              <div class="pagination-edge pagination-edge--previous">
                {currentPage > 1 && (
                  <a href={paginationHref(currentPage - 1)} rel="prev">
                    Previous
                  </a>
                )}
              </div>

              <ol>
                {Array.from(
                  { length: totalPages },
                  (_, index) => index + 1,
                ).map((page) => (
                  <li>
                    {page === currentPage ? (
                      <span aria-current="page">{page}</span>
                    ) : (
                      <a href={paginationHref(page)}>{page}</a>
                    )}
                  </li>
                ))}
              </ol>

              <div class="pagination-edge pagination-edge--next">
                {currentPage < totalPages && (
                  <a href={paginationHref(currentPage + 1)} rel="next">
                    Next
                  </a>
                )}
              </div>
            </nav>
          )
        }
      </section>
    </main>

    <dialog class="coming-soon-dialog" aria-labelledby="coming-soon-title">
      <div class="coming-soon-content">
        <p class="coming-soon-label">Coming soon</p>
        <h2 id="coming-soon-title">구현 예정</h2>
        <p class="coming-soon-message"></p>
        <button class="coming-soon-close" type="button">Close</button>
      </div>
    </dialog>

    <script>
      const comingSoonDialog = document.querySelector<HTMLDialogElement>(
        ".coming-soon-dialog",
      );
      const comingSoonMessage = comingSoonDialog?.querySelector<HTMLElement>(
        ".coming-soon-message",
      );
      const comingSoonClose =
        comingSoonDialog?.querySelector<HTMLButtonElement>(
          ".coming-soon-close",
        );

      document
        .querySelectorAll<HTMLElement>("[data-coming-soon]")
        .forEach((trigger) => {
          trigger.addEventListener("click", () => {
            if (!comingSoonDialog || !comingSoonMessage) return;

            const feature = trigger.dataset.comingSoon ?? "해당 기능";
            comingSoonMessage.textContent = `${feature} 기능은 현재 준비 중입니다.`;
            comingSoonDialog.showModal();
          });
        });

      comingSoonClose?.addEventListener("click", () =>
        comingSoonDialog?.close(),
      );
      comingSoonDialog?.addEventListener("click", (event) => {
        if (event.target === comingSoonDialog) comingSoonDialog.close();
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #f2f0eb;
    --paper: #11110f;
    --line: rgba(242, 240, 235, 0.28);
    --muted: rgba(242, 240, 235, 0.66);
    --side: clamp(32px, 6.25vw, 100px);
    --font-sans:
      "Helvetica Neue", Helvetica, Arial, "Pretendard", "Apple SD Gothic Neo",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    color: var(--ink);
    background: var(--paper);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
  }

  body:has(.coming-soon-dialog[open]) {
    overflow: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    color: inherit;
    font: inherit;
  }

  img {
    display: block;
    max-width: 100%;
  }

  :focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 4px;
  }

  .site-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 132px;
    padding: 0 var(--side);
    letter-spacing: 0.08em;
  }

  .header-side {
    display: flex;
    align-items: center;
    gap: clamp(22px, 3.1vw, 52px);
    font-size: 10px;
    text-transform: uppercase;
  }

  .header-side--right {
    justify-content: flex-end;
  }

  .header-side a,
  .header-side button,
  .pagination a {
    position: relative;
  }

  .header-side a::after,
  .header-side button::after,
  .pagination a::after {
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 260ms ease;
  }

  .header-side a:hover::after,
  .header-side a:focus-visible::after,
  .header-side button:hover::after,
  .header-side button:focus-visible::after,
  .pagination a:hover::after,
  .pagination a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header-side button {
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }

  .wordmark {
    padding: 8px 14px;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: 27px;
    font-weight: 500;
    letter-spacing: 0.22em;
    line-height: 1;
  }

  .journal-count,
  .journal-page {
    margin: 0;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .journal {
    padding: 0 var(--side) 160px;
  }

  .journal-toolbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 112px;
  }

  .journal-toolbar h1 {
    justify-self: start;
    margin: 0;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .journal-page {
    justify-self: center;
  }

  .journal-count {
    justify-self: end;
  }

  .journal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(18px, 1.9vw, 30px);
    row-gap: 74px;
  }

  .journal-card {
    min-width: 0;
  }

  .journal-card-link {
    display: block;
  }

  .image-frame {
    display: block;
    width: 100%;
    overflow: hidden;
    background: #161616;
    aspect-ratio: 3 / 4;
  }

  .image-frame .card-image {
    width: 100%;
    height: 100%;
    filter: grayscale(1);
    object-fit: cover;
    object-position: center;
    transition: filter 380ms ease;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 12px;
    padding-top: 15px;
    border-top: 1px solid var(--ink);
  }

  .card-meta h3,
  .card-meta p {
    margin: 0;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.075em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .card-meta h3 {
    max-width: 62%;
  }

  .card-meta p {
    color: var(--muted);
    text-align: right;
  }

  .empty-state {
    min-height: 360px;
    margin: 0;
    padding-top: 42px;
    border-top: 1px solid var(--ink);
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-top: 80px;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pagination ol {
    display: flex;
    gap: 50px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pagination li span {
    padding-bottom: 4px;
    border-bottom: 2px solid var(--ink);
  }

  .pagination-edge--next {
    justify-self: end;
  }

  .coming-soon-dialog {
    width: min(460px, calc(100vw - 36px));
    padding: 0;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }

  .coming-soon-dialog::backdrop {
    background: rgba(17, 17, 15, 0.55);
  }

  .coming-soon-content {
    padding: 42px;
  }

  .coming-soon-label,
  .coming-soon-message {
    margin: 0;
  }

  .coming-soon-label {
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .coming-soon-content h2 {
    margin: 18px 0 14px;
    font-size: 34px;
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .coming-soon-message {
    color: var(--muted);
    font-size: 11px;
  }

  .coming-soon-close {
    margin-top: 42px;
    padding: 8px 0;
    border: 0;
    border-bottom: 1px solid var(--ink);
    background: transparent;
    cursor: pointer;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (hover: hover) and (pointer: fine) {
    .journal-card-link:hover .card-image {
      filter: grayscale(0);
    }
  }

  .journal-card-link:focus-visible .card-image {
    filter: grayscale(0);
  }

  @media (max-width: 760px) {
    :root {
      --side: 18px;
    }

    .site-header {
      grid-template-columns: 1fr auto;
      height: 70px;
      border-bottom: 1px solid var(--line);
    }

    .header-side {
      display: none;
    }

    .wordmark {
      grid-column: 1;
      justify-self: start;
      padding: 8px 0;
      font-size: 21px;
    }

    .journal {
      padding-bottom: 92px;
    }

    .journal-toolbar {
      height: 86px;
    }

    .journal-grid {
      grid-template-columns: 1fr;
      row-gap: 52px;
    }

    .image-frame .card-image {
      filter: none;
    }

    .pagination {
      grid-template-columns: 1fr auto 1fr;
      margin-top: 64px;
    }

    .pagination ol {
      gap: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
