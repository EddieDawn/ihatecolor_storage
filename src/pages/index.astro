---
import { Image } from "astro:assets";

import { getLandingPagePhotos } from "../lib/content/landing-page";
import "../styles/landing.css";

const { heroPhoto: hero } = await getLandingPagePhotos();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Justyes gallery — 두 사람 사이의 다정한 순간을 기록하는 웨딩 스냅 갤러리"
    />
    <title>Justyes gallery — Wedding stories</title>
  </head>
  <body class="landing-page">
    <header class="site-header">
      <div class="brand">
        <strong>Justyes</strong><span>Gallery · Wedding stories</span>
      </div>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__rail">
          <a class="hero__rail-link" href="/photos/">
            <span>Journal</span>
            <svg viewBox="0 0 24 10" aria-hidden="true">
              <path d="M0 5h22M17 1l5 4-5 4"></path>
            </svg>
          </a>
          <div class="hero__rail-bottom">
            <div class="hero__rail-links">
              <span class="hero__rail-link">
                <span>Contact</span>
                <svg viewBox="0 0 24 10" aria-hidden="true">
                  <path d="M0 5h22M17 1l5 4-5 4"></path>
                </svg>
              </span>
              <a
                class="hero__rail-link"
                href="https://www.instagram.com/justyesgallery?igsi=MWJqaXJ5MWVqa2QyZg=="
              >
                <span>Instagram</span>
                <svg viewBox="0 0 24 10" aria-hidden="true">
                  <path d="M0 5h22M17 1l5 4-5 4"></path>
                </svg>
              </a>
            </div>
            <p>Wedding<br />Archive 2024—26</p>
          </div>
        </div>

        <div class="hero__media-wrap">
          <a
            class="photo-button hero__media"
            href={`/photos/${hero.slug}/?from=landing`}
            aria-label={`${hero.title} 상세 페이지 보기`}
          >
            <Image
              src={hero.image.url}
              width={hero.image.width}
              height={hero.image.height}
              alt={hero.altText}
              widths={[720, 1080, 1440]}
              sizes="54vw"
              format="webp"
              quality={88}
              loading="eager"
              fetchpriority="high"
            />
          </a>
          <p class="hero__image-index">No. 001</p>
        </div>

        <div class="hero__copy">
          <p class="kicker">A quiet wedding archive</p>
          <h1 id="hero-title"><span>I do.</span><span>Still.</span></h1>
          <div class="hero__caption">
            <p>포즈와 포즈 사이,<br />두 사람만 아는 표정과 온도.</p>
            <p>Justyes gallery<br />Seoul, 2026</p>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
