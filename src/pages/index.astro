---
import { Image } from "astro:assets";

import { getLandingPagePhotos } from "../lib/content/landing-page";
import type { Photo } from "../lib/content/photo-model";
import "../styles/landing.css";

const { heroPhoto: hero, storyPhotos } = await getLandingPagePhotos();
const [platform, walk, arrival, bicycle, harbor, closing] = storyPhotos;
const photoMeta = (photo: Photo) =>
  [photo.location, photo.shotAt?.slice(0, 4)].filter(Boolean).join(" · ") ||
  "—";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Justyes gallery — 두 사람 사이의 다정한 순간을 기록하는 웨딩 스냅 갤러리"
    />
    <title>Justyes gallery — Wedding stories</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class="landing-page">
    <header class="site-header">
      <div class="brand">
        <strong>Justyes</strong><span>Gallery · Wedding stories</span>
      </div>
      <nav aria-label="주요 메뉴">
        <a href="/photos/">Photos</a>
      </nav>
      <div class="header-meta">
        <span>Seoul, KR</span><span>Stories / 2026</span>
      </div>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__rail">
          <p>Wedding<br />Archive 2024—26</p><p class="hero__coordinate">
            37.5665° N<br />126.9780° E
          </p>
        </div>
        <div class="hero__media-wrap">
          <a
            class="photo-button hero__media"
            href={`/photos/${hero.slug}/?from=landing`}
            aria-label={`${hero.title} 상세 페이지 보기`}
          >
            <Image
              src={hero.image.url}
              width={hero.image.width}
              height={hero.image.height}
              alt={hero.altText}
              widths={[720, 1080, 1440]}
              sizes="54vw"
              format="webp"
              quality={88}
              loading="eager"
              fetchpriority="high"
            />
          </a>
          <p class="hero__image-index">No. 001</p>
        </div>
        <div class="hero__copy">
          <p class="kicker">A quiet wedding archive</p>
          <h1 id="hero-title"><span>I do.</span><span>Still.</span></h1>
          <div class="hero__caption">
            <p>포즈와 포즈 사이,<br />두 사람만 아는 표정과 온도.</p><p>
              Justyes gallery<br />Seoul, 2026
            </p>
          </div>
        </div>
      </section>

      <section class="story" aria-labelledby="story-title">
        <header class="story-intro reveal">
          <p class="section-number">01 / Wedding essay</p>
          <h2 id="story-title">
            Love is remembered in the gestures no one asked for.
          </h2>
          <p class="story-intro__body">
            Justyes gallery는 정해진 포즈보다 두 사람 사이에 자연스럽게 흐르는
            시선과 손짓을 기록합니다. 오래 지나 다시 보아도 그날의 공기까지
            떠오르는 웨딩 스냅을 지향합니다.
          </p>
        </header>

        <div class="essay-layout">
          <figure class="essay-photo essay-photo--platform reveal">
            <a
              class="photo-button"
              href={`/photos/${platform.slug}/?from=landing`}
              aria-label={`${platform.title} 상세 페이지 보기`}
              ><Image
                src={platform.image.url}
                width={platform.image.width}
                height={platform.image.height}
                alt={platform.altText}
                widths={[640, 960, 1280]}
                sizes="46vw"
                format="webp"
                quality={86}
                loading="lazy"
              /></a
            >
            <figcaption>
              <span>{platform.title}</span><span>{photoMeta(platform)}</span
              ><span>01</span>
            </figcaption>
          </figure>
          <figure class="essay-photo essay-photo--walk reveal">
            <a
              class="photo-button"
              href={`/photos/${walk.slug}/?from=landing`}
              aria-label={`${walk.title} 상세 페이지 보기`}
              ><Image
                src={walk.image.url}
                width={walk.image.width}
                height={walk.image.height}
                alt={walk.altText}
                widths={[480, 720, 960]}
                sizes="31vw"
                format="webp"
                quality={86}
                loading="lazy"
              /></a
            >
            <figcaption>
              <span>{walk.title}</span><span>{photoMeta(walk)}</span><span
                >02</span
              >
            </figcaption>
          </figure>
          <blockquote class="essay-quote reveal">
            <p>
              “사랑은 가장 자연스러운 순간에<br />가장 오래 남는 표정이 된다.”
            </p><cite>Justyes note, Spring 2026</cite>
          </blockquote>
          <figure class="essay-photo essay-photo--arrival reveal">
            <a
              class="photo-button"
              href={`/photos/${arrival.slug}/?from=landing`}
              aria-label={`${arrival.title} 상세 페이지 보기`}
              ><Image
                src={arrival.image.url}
                width={arrival.image.width}
                height={arrival.image.height}
                alt={arrival.altText}
                widths={[560, 840, 1120]}
                sizes="39vw"
                format="webp"
                quality={86}
                loading="lazy"
              /></a
            >
            <figcaption>
              <span>{arrival.title}</span><span>{photoMeta(arrival)}</span><span
                >03</span
              >
            </figcaption>
          </figure>
          <figure class="essay-photo essay-photo--bicycle reveal">
            <a
              class="photo-button"
              href={`/photos/${bicycle.slug}/?from=landing`}
              aria-label={`${bicycle.title} 상세 페이지 보기`}
              ><Image
                src={bicycle.image.url}
                width={bicycle.image.width}
                height={bicycle.image.height}
                alt={bicycle.altText}
                widths={[480, 720, 960]}
                sizes="39vw"
                format="webp"
                quality={86}
                loading="lazy"
              /></a
            >
            <figcaption>
              <span>{bicycle.title}</span><span>{photoMeta(bicycle)}</span><span
                >04</span
              >
            </figcaption>
          </figure>
          <div class="interlude reveal" aria-label="사진 에세이 중간 글">
            <p>Before → After</p><h3>
              A photograph keeps the warmth after the day has passed.
            </h3><p>
              의식이 끝난 뒤에도 사진 속에는 서로를 바라보던 마음과 그날의
              따뜻한 빛이 함께 남습니다.
            </p>
          </div>
          <figure class="essay-photo essay-photo--harbor reveal">
            <a
              class="photo-button"
              href={`/photos/${harbor.slug}/?from=landing`}
              aria-label={`${harbor.title} 상세 페이지 보기`}
              ><Image
                src={harbor.image.url}
                width={harbor.image.width}
                height={harbor.image.height}
                alt={harbor.altText}
                widths={[640, 960, 1280]}
                sizes="46vw"
                format="webp"
                quality={86}
                loading="lazy"
              /></a
            >
            <figcaption>
              <span>{harbor.title}</span><span>{photoMeta(harbor)}</span><span
                >05</span
              >
            </figcaption>
          </figure>
          <figure class="essay-photo essay-photo--closing reveal">
            <a
              class="photo-button"
              href={`/photos/${closing.slug}/?from=landing`}
              aria-label={`${closing.title} 상세 페이지 보기`}
              ><Image
                src={closing.image.url}
                width={closing.image.width}
                height={closing.image.height}
                alt={closing.altText}
                widths={[480, 720, 960]}
                sizes="39vw"
                format="webp"
                quality={86}
                loading="lazy"
              /></a
            >
            <figcaption>
              <span>{closing.title}</span><span>{photoMeta(closing)}</span><span
                >06</span
              >
            </figcaption>
          </figure>
        </div>
        <footer class="story-end reveal">
          <p>End of essay 01</p>
        </footer>
      </section>
    </main>

    <script>
      const revealItems = [
        ...document.querySelectorAll<HTMLElement>(".reveal"),
      ];
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }),
          { threshold: 0.12, rootMargin: "0px 0px -5%" },
        );
        revealItems.forEach((item) => observer.observe(item));
      } else revealItems.forEach((item) => item.classList.add("is-visible"));
    </script>
  </body>
</html>
