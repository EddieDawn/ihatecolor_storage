---
import PhotoListingPage from "../../../components/photos/PhotoListingPage.astro";
import { getPhotos, type Photo } from "../../../lib/content/photos";

interface Props {
  photos: Photo[];
  currentPage: number;
  totalPages: number;
  totalItems: number;
}

export async function getStaticPaths() {
  const pageSize = 9;
  const photos = await getPhotos();
  const totalPages = Math.max(1, Math.ceil(photos.length / pageSize));

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const currentPage = index + 2;
    const start = (currentPage - 1) * pageSize;

    return {
      params: { page: String(currentPage) },
      props: {
        photos: photos.slice(start, start + pageSize),
        currentPage,
        totalPages,
        totalItems: photos.length,
      },
    };
  });
}

const { photos, currentPage, totalPages, totalItems } = Astro.props;
---

<PhotoListingPage
  photos={photos}
  currentPage={currentPage}
  totalPages={totalPages}
  totalItems={totalItems}
/>
